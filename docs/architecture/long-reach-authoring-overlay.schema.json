{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Long Reach authoring overlay sidecar",
    "description": "Design-time authoring annotations over the-long-reach.jpg, never runtime transition authority. Semantic review rules accompany this schema in macro-atlas-and-seed-redesign.md.",
    "type": "object",
    "additionalProperties": false,
    "required": ["schemaVersion", "image", "atlas", "entries"],
    "properties": {
        "$schema": { "type": "string", "minLength": 1 },
        "schemaVersion": { "const": 1 },
        "image": { "const": "the-long-reach.jpg" },
        "atlas": { "const": "backend/src/data/theLongReachMacroAtlas.json" },
        "entries": {
            "type": "array",
            "items": { "$ref": "#/definitions/entry" }
        }
    },
    "definitions": {
        "text": { "type": "string", "pattern": "\\S" },
        "ref": {
            "type": "string",
            "description": "Semantic atlas reference, never a runtime location GUID.",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)+$",
            "not": { "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$" }
        },
        "refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/definitions/ref" }
        },
        "coordinate": { "type": "number", "minimum": 0, "maximum": 1 },
        "point": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "$ref": "#/definitions/coordinate" }
        },
        "markerGeometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "anchor"],
            "properties": {
                "type": { "const": "marker" },
                "anchor": { "$ref": "#/definitions/point" },
                "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
                "labelAnchor": { "$ref": "#/definitions/point" }
            }
        },
        "lineGeometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "points"],
            "properties": {
                "type": { "const": "line" },
                "points": {
                    "type": "array",
                    "minItems": 2,
                    "items": { "$ref": "#/definitions/point" }
                },
                "labelAnchor": { "$ref": "#/definitions/point" }
            }
        },
        "polygonGeometry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "points"],
            "properties": {
                "type": { "const": "polygon" },
                "points": {
                    "type": "array",
                    "minItems": 3,
                    "items": { "$ref": "#/definitions/point" }
                },
                "labelAnchor": { "$ref": "#/definitions/point" }
            }
        },
        "geometry": {
            "oneOf": [
                { "$ref": "#/definitions/markerGeometry" },
                { "$ref": "#/definitions/lineGeometry" },
                { "$ref": "#/definitions/polygonGeometry" }
            ]
        },
        "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "kind", "geometry", "authoringState", "coverage", "notes"],
            "properties": {
                "id": {
                    "type": "string",
                    "description": "Stable overlay identity, independent of atlas/runtime identity.",
                    "pattern": "^lr-overlay-[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "label": { "$ref": "#/definitions/text" },
                "kind": { "enum": ["region", "corridor", "barrier"] },
                "geometry": { "$ref": "#/definitions/geometry" },
                "authoringState": {
                    "enum": ["authored", "transition-ready", "next-to-author", "blocked", "inspiration-only"]
                },
                "coverage": {
                    "description": "Hand-authored coverage of this entry's footprint, independent of operational readiness.",
                    "enum": ["none", "partial", "complete"]
                },
                "authoringReadiness": {
                    "description": "Reviewed runtime AreaReadinessState snapshot, not permission to cross a boundary.",
                    "enum": ["ready", "partial", "blocked", "deferred"]
                },
                "areaRefs": { "$ref": "#/definitions/refs" },
                "corridorRefs": { "$ref": "#/definitions/refs" },
                "barrierRefs": { "$ref": "#/definitions/refs" },
                "segmentRefs": { "$ref": "#/definitions/refs" },
                "entrySegmentRef": { "$ref": "#/definitions/ref" },
                "entryAnchorId": {
                    "type": "string",
                    "description": "Optional existing local traversal location GUID; not a semantic atlas ref.",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                },
                "priority": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Editorial queue order: lower numbers first; ties allowed. Required for next-to-author."
                },
                "notes": {
                    "$ref": "#/definitions/text",
                    "description": "Scope, mapping uncertainty, coverage evidence, or reason for blocking/deferral."
                }
            },
            "allOf": [
                {
                    "if": { "properties": { "authoringState": { "const": "inspiration-only" } } },
                    "then": {
                        "properties": { "coverage": { "const": "none" } },
                        "not": {
                            "anyOf": [
                                { "required": ["authoringReadiness"] },
                                { "required": ["entrySegmentRef"] },
                                { "required": ["entryAnchorId"] }
                            ]
                        }
                    },
                    "else": { "required": ["authoringReadiness"] }
                },
                {
                    "if": { "properties": { "authoringState": { "const": "authored" } } },
                    "then": { "properties": { "coverage": { "const": "complete" } } }
                },
                {
                    "if": { "properties": { "authoringState": { "const": "transition-ready" } } },
                    "then": {
                        "required": ["areaRefs", "entrySegmentRef"],
                        "properties": {
                            "coverage": { "enum": ["partial", "complete"] },
                            "authoringReadiness": { "const": "partial" }
                        }
                    }
                },
                {
                    "if": { "properties": { "authoringState": { "enum": ["blocked", "next-to-author"] } } },
                    "then": { "properties": { "authoringReadiness": { "enum": ["partial", "blocked", "deferred"] } } }
                },
                {
                    "if": { "properties": { "authoringState": { "const": "next-to-author" } } },
                    "then": { "required": ["priority"] }
                }
            ]
        }
    }
}
