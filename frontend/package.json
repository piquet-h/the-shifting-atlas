{
    "name": "the-shifting-atlas-frontend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "clean": "rm -rf dist .cache coverage",
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "swa": "swa start --config ../swa-cli.config.json",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src test --ext .ts,.tsx",
        "format": "prettier --write \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
        "a11y:serve": "vite --port 5173",
        "a11y:scan": "node ./scripts/run-axe.mjs",
        "a11y": "start-server-and-test a11y:serve http-get://localhost:5173 a11y:scan",
        "test": "vitest run",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:headed": "playwright test --headed"
    },
    "engines": {
        "node": "22.x",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "@microsoft/applicationinsights-web": "^3.4.5",
        "@piquet-h/shared": "^0.3.159",
        "@tanstack/react-query": "^5.104.3",
        "@tanstack/react-query-devtools": "^5.104.3",
        "@types/cytoscape": "^3.21.9",
        "cytoscape": "^3.34.4",
        "isomorphic-dompurify": "^2.36.0",
        "marked": "^17.0.6",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@axe-core/cli": "^4.14.0",
        "@azure/static-web-apps-cli": "^2.0.10",
        "@playwright/test": "^1.64.1",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/typography": "^0.5.20",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/dompurify": "^3.0.5",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@vitejs/plugin-react": "^5.2.0",
        "autoprefixer": "^10.6.1",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0",
        "happy-dom": "^21.0.4",
        "jsdom": "^25.0.1",
        "msw": "^2.15.0",
        "postcss": "^8.5.30",
        "prettier": "^3.9.10",
        "start-server-and-test": "^2.1.5",
        "tailwindcss": "^3.4.19",
        "typescript": "^5.9.3",
        "vite": "^8.3.4",
        "vite-plugin-svgr": "^4.5.0",
        "vitest": "^4.1.11"
    }
}
