{
    "name": "the-shifting-atlas-root",
    "private": true,
    "version": "0.0.0",
    "license": "MIT",
    "workspaces": [
        "shared",
        "backend",
        "frontend"
    ],
    "scripts": {
        "build:shared": "npm run build --workspace @piquet-h/shared && node scripts/bundle-prompts.mjs",
        "build:backend": "npm run build --workspace the-shifting-atlas-backend",
        "build:frontend": "npm run build --workspace the-shifting-atlas-frontend",
        "package:backend": "node scripts/package-backend-function.mjs",
        "dev:backend": "npm run dev --workspace the-shifting-atlas-backend",
        "dev:frontend": "npm run dev --workspace the-shifting-atlas-frontend",
        "dev:fullstack": "npm run dev:fullstack --workspace the-shifting-atlas-backend",
        "dev:fullstack:memory": "npm run use:memory --workspace the-shifting-atlas-backend && npm run dev:fullstack --workspace the-shifting-atlas-backend",
        "build": "npm run build:shared && npm run build:backend && npm run build:frontend",
        "test:shared": "npm run test --workspace @piquet-h/shared",
        "test:backend": "npm run test --workspace the-shifting-atlas-backend",
        "test:frontend": "npm run test --workspace the-shifting-atlas-frontend",
        "test:scripts": "node --test scripts/*.test.mjs scripts/test/*.test.mjs",
        "test": "npm run test:shared && npm run test:backend && npm run test:frontend",
        "verify:instructions": "node scripts/verify-instructions.mjs",
        "verify:instructions:json": "node scripts/verify-instructions.mjs --format json",
        "verify:docs-policy": "node scripts/verify-docs-policy.mjs",
        "verify:docs-policy:json": "node scripts/verify-docs-policy.mjs --json",
        "verify:docs-policy:strict": "node scripts/verify-docs-policy.mjs --strict",
        "verify:invariants": "npm run lint:backend && npm run lint:shared",
        "verify:invariants:json": "node scripts/verify-runtime-invariants.mjs --json",
        "verify:invariants:strict": "npm run lint:backend && npm run lint:shared",
        "verify:runtime-behavior": "npm run test:runtime-invariants --workspace the-shifting-atlas-backend",
        "map:boundaries": "node scripts/render-boundary-map.mjs",
        "map:long-reach": "node scripts/long-reach-authoring.mjs render",
        "report:long-reach": "node scripts/long-reach-authoring.mjs queue",
        "concept:issues:dry": "node scripts/generate-concept-issues.mjs",
        "concept:issues:create": "cross-env CREATE_CONCEPT_ISSUES=true node scripts/generate-concept-issues.mjs",
        "workbooks:export": "node scripts/observability/export-workbooks.mjs",
        "workbooks:verify": "node scripts/observability/verify-workbooks.mjs",
        "catalog:check": "node scripts/observability/check-catalog-events.mjs",
        "catalog:check:json": "node scripts/observability/check-catalog-events.mjs --json",
        "lint:shared": "npm run lint --workspace @piquet-h/shared",
        "lint:backend": "npm run lint --workspace the-shifting-atlas-backend",
        "lint:frontend": "npm run lint --workspace the-shifting-atlas-frontend",
        "lint": "npm run lint:shared && npm run lint:backend && npm run lint:frontend",
        "typecheck:shared": "npm run typecheck --workspace @piquet-h/shared",
        "typecheck:backend": "npm run typecheck --workspace the-shifting-atlas-backend",
        "typecheck:frontend": "npm run typecheck --workspace the-shifting-atlas-frontend",
        "typecheck": "npm run typecheck:shared && npm run typecheck:backend && npm run typecheck:frontend",
        "format:shared": "npm run format --workspace @piquet-h/shared",
        "format:backend": "npm run format --workspace the-shifting-atlas-backend",
        "format:frontend": "npm run format --workspace the-shifting-atlas-frontend",
        "format": "npm run format:shared && npm run format:backend && npm run format:frontend",
        "format:check:shared": "npm run format:check --workspace @piquet-h/shared",
        "format:check:backend": "npm run format:check --workspace the-shifting-atlas-backend",
        "format:check:frontend": "npm run format:check --workspace the-shifting-atlas-frontend",
        "format:check": "npm run format:check:shared && npm run format:check:backend && npm run format:check:frontend",
        "validate:partitions": "tsx scripts/validate-partition-distribution.ts"
    },
    "engines": {
        "node": "22.x"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@octokit/core": "^5.2.2",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "ajv": "^6.15.0",
        "cross-env": "^7.0.3",
        "eslint": "^9.39.5",
        "eslint-plugin-jsx-a11y": "^6.10.2",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^5.2.0"
    }
}
