{
    "name": "the-shifting-atlas-backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "dist/src/{index.js,functions/*.js,mcp/**/*.js}",
    "scripts": {
        "clean": "rm -rf dist .cache coverage",
        "build": "tsc",
        "watch": "tsc --watch --preserveWatchOutput",
        "typecheck": "tsc --noEmit",
        "lint:data": "node ../scripts/verify-runtime-invariants.mjs --strict",
        "lint": "eslint src test --ext .ts && npm run lint:data",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
        "test": "npm run test:unit && npm run test:integration",
        "test:unit": "NODE_ENV=test node --test --import=tsx test/unit/*.test.ts",
        "test:integration": "NODE_ENV=test node --test --import=tsx test/integration/*.test.ts",
        "test:runtime-invariants": "NODE_ENV=test node --test --import=tsx test/unit/worldEventProcessor.test.ts test/unit/exitGenerationHintProcessor.test.ts test/unit/queueSyncLocationAnchors.test.ts test/unit/worldClockService.test.ts test/integration/correlationIdFlow.test.ts test/integration/worldClockService.test.ts test/integration/moveHandler.exitGeneration.test.ts test/integration/queueSyncLocationAnchors.test.ts test/integration/worldEventProcessing.test.ts test/integration/exitGenerationHint.integration.test.ts",
        "test:e2e": "NODE_ENV=test PERSISTENCE_MODE=cosmos node --test --test-timeout=300000 --import=tsx test/e2e/*.e2e.test.ts",
        "test:cov": "NODE_ENV=test c8 --reporter=text --reporter=lcov node --test --import=tsx --import=./test/setup.ts test/**/*.test.ts || true",
        "seed:production": "npm run use:cosmos && PERSISTENCE_MODE=cosmos tsx scripts/seed-production.ts",
        "reconcile:world": "PERSISTENCE_MODE=memory tsx scripts/reconcile-world.ts --dry-run",
        "reconcile:world:cosmos": "PERSISTENCE_MODE=cosmos tsx scripts/reconcile-world.ts --mode=cosmos --prune-exits --prune-locations",
        "scan:graph-consistency": "node ../scripts/scan-exits-consistency.mjs",
        "query:deadletters": "tsx scripts/query-deadletters.ts",
        "validate:partitions": "tsx ../scripts/validate-partition-distribution.ts",
        "use:memory": "cp local.settings.memory.json local.settings.json && echo '✓ Switched to MEMORY mode'",
        "use:cosmos": "cp local.settings.cosmos.json local.settings.json && echo '✓ Switched to COSMOS mode'",
        "predev": "npm run build",
        "dev": "concurrently -k -n tsc,host -c yellow,blue \"npm:watch\" \"func start\"",
        "dev:fullstack": "npm run build && concurrently -k -n backend,frontend -c blue,magenta \"func start\" \"cd ../frontend && npm run swa\"",
        "start": "npm run build && func start",
        "verify:instructions": "node ../scripts/verify-instructions.mjs"
    },
    "engines": {
        "node": "22.x",
        "npm": ">=10.0.0"
    },
    "dependencies": {
        "@azure/cosmos": "^4.10.1",
        "@azure/functions": "^4.16.5",
        "@azure/identity": "^4.14.0",
        "@azure/keyvault-secrets": "^4.11.2",
        "@azure/service-bus": "^7.10.0",
        "@piquet-h/shared": "^0.3.159",
        "@types/marked": "^5.0.2",
        "applicationinsights": "^2.9.8",
        "ci": "^2.3.0",
        "gremlin": "^3.8.2",
        "inversify": "^7.11.0",
        "marked": "^17.0.6",
        "openai": "^6.49.0",
        "reflect-metadata": "^0.2.2",
        "ws": "^8.22.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/gremlin": "^3.6.7",
        "@types/node": "^22.20.5",
        "@types/sinon": "^20.0.0",
        "@types/uuid": "^10.0.0",
        "@types/ws": "^8.18.2",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "c8": "^10.1.3",
        "concurrently": "^10.0.6",
        "eslint": "^9.39.5",
        "eslint-plugin-prettier": "^5.5.7",
        "prettier": "^3.9.10",
        "sinon": "^21.1.2",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "why-is-node-running": "^3.2.3"
    }
}
